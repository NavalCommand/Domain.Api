# Read final direct properties after configuration. TARGET_PROPERTY generator expressions
# expand transitive links under CMP0189, so export raw interface properties and reject expressions.
function(NavalCommandExportDomainGraph)
    get_property(graphPath GLOBAL PROPERTY NAVALCOMMAND_DOMAIN_GRAPH_PATH)
    get_property(domainTargetNames DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(sourceDirectories DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY SUBDIRECTORIES)
    foreach(sourceDirectory IN LISTS sourceDirectories)
        get_property(directoryTargets DIRECTORY "${sourceDirectory}" PROPERTY BUILDSYSTEM_TARGETS)
        list(APPEND domainTargetNames ${directoryTargets})
    endforeach()
    list(FILTER domainTargetNames INCLUDE REGEX "\\.Api$")
    list(REMOVE_DUPLICATES domainTargetNames)
    list(SORT domainTargetNames)
    set(domainGraphContent "")
    foreach(domainTarget IN LISTS domainTargetNames)
        if(NOT TARGET "${domainTarget}")
            message(FATAL_ERROR "Missing domain interface target: ${domainTarget}")
        endif()
        get_target_property(targetType "${domainTarget}" TYPE)
        if(NOT targetType STREQUAL "INTERFACE_LIBRARY")
            message(FATAL_ERROR "Domain target must be INTERFACE_LIBRARY: ${domainTarget} (${targetType})")
        endif()
        get_target_property(directLinks "${domainTarget}" INTERFACE_LINK_LIBRARIES)
        if(NOT directLinks)
            set(directLinks "")
        endif()
        get_target_property(interfaceFeatures "${domainTarget}" INTERFACE_COMPILE_FEATURES)
        if(NOT interfaceFeatures)
            set(interfaceFeatures "")
        endif()
        get_target_property(targetStandard "${domainTarget}" CXX_STANDARD)
        string(APPEND domainGraphContent "${domainTarget}|${directLinks}|${interfaceFeatures}|${targetStandard}\n")
    endforeach()
    file(WRITE "${graphPath}" "${domainGraphContent}")
endfunction()

set_property(GLOBAL PROPERTY NAVALCOMMAND_DOMAIN_GRAPH_PATH "${CMAKE_CURRENT_BINARY_DIR}/domain-targets.txt")
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL NavalCommandExportDomainGraph)
